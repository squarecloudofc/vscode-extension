{
  "version": "5.2.0",
  "name": "squarecloud",
  "publisher": "squarecloud",
  "displayName": "Square Cloud",
  "description": "A VSCode extension for managing your Square Cloud applications.",
  "categories": [
    "Other"
  ],
  "icon": "resources/squarecloud.png",
  "packageManager": "pnpm@11.5.0",
  "keywords": [
    "squarecloud",
    "square cloud",
    "host",
    "bot",
    "website",
    "intellisense"
  ],
  "homepage": "https://github.com/squarecloudofc/vscode-extension/",
  "author": {
    "name": "João Gabriel Tonaco",
    "url": "https://github.com/joaotonaco/"
  },
  "contributors": [
    {
      "name": "João Otávio Stivi",
      "url": "https://github.com/JoaoOtavioS"
    }
  ],
  "sponsor": {
    "url": "https://squarecloud.app/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/squarecloudofc/vscode-extension"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "activationEvents": [
    "workspaceContains:**/squarecloud.app",
    "workspaceContains:**/squarecloud.config"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "lint": "biome check --write .",
    "build": "pnpm run check-types && pnpm run check-strings && pnpm run check-realtime && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "check-authorize": "node scripts/check-authorize.mjs",
    "watch": "concurrently --raw \"pnpm:watch:*\"",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "vscode:prepublish": "pnpm run build",
    "publish:vsce": "vsce publish --allow-star-activation --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "package": "vsce package --allow-star-activation --no-dependencies",
    "check-strings": "node scripts/check-strings.mjs",
    "check-realtime": "node scripts/check-realtime.mjs"
  },
  "dependencies": {
    "@squarecloud/api": "^5.0.0",
    "ignore": "^7.0.6",
    "jszip": "^3.10.1",
    "vscode-ext-localisation": "^1.1.0",
    "xoid": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "ovsx": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "menus": {
      "commandPalette": [
        {
          "command": "squarecloud.commitEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.copyIdEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.deleteDatabase",
          "when": "false"
        },
        {
          "command": "squarecloud.deleteEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.deleteWorkspace",
          "when": "false"
        },
        {
          "command": "squarecloud.downloadDatabaseCertificate",
          "when": "false"
        },
        {
          "command": "squarecloud.envsEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.favoriteEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.generateInviteCode",
          "when": "false"
        },
        {
          "command": "squarecloud.leaveWorkspace",
          "when": "false"
        },
        {
          "command": "squarecloud.linkGithubAppEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.logsEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.metricsEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.networkErrorsEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.networkLogsEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.networkPerformanceEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.openEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.purgeCacheEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.realtimeEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.refreshEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.refreshWorkspaces",
          "when": "false"
        },
        {
          "command": "squarecloud.restartEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.snapshotEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.snapshotRestoreEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.startDatabase",
          "when": "false"
        },
        {
          "command": "squarecloud.startEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.stopDatabase",
          "when": "false"
        },
        {
          "command": "squarecloud.stopEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.unfavoriteEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.unlinkGithubAppEntry",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "squarecloud.refreshCache",
          "when": "view == dashboard-view",
          "group": "navigation@1"
        },
        {
          "command": "squarecloud.uploadApplication",
          "when": "view == dashboard-view",
          "group": "navigation@2"
        },
        {
          "command": "squarecloud.createDatabase",
          "when": "view == dashboard-view"
        },
        {
          "command": "squarecloud.createWorkspace",
          "when": "view == dashboard-view"
        },
        {
          "command": "squarecloud.logout",
          "when": "view == dashboard-view"
        }
      ]
    },
    "commands": [
      {
        "command": "squarecloud.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.uploadApplication",
        "title": "%command.uploadApplication%",
        "category": "Square Cloud",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "squarecloud.refreshCache",
        "title": "%command.refresh%",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "squarecloud.refreshEntry",
        "title": "%command.refresh%",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "squarecloud.refreshWorkspaces",
        "title": "%command.refresh%",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "squarecloud.logsEntry",
        "title": "%command.logsEntry%",
        "icon": {
          "light": "resources/light/logs.svg",
          "dark": "resources/dark/logs.svg"
        }
      },
      {
        "command": "squarecloud.favoriteEntry",
        "title": "%command.favorite%",
        "icon": {
          "light": "resources/light/star.svg",
          "dark": "resources/dark/star.svg"
        }
      },
      {
        "command": "squarecloud.unfavoriteEntry",
        "title": "%command.unfavorite%",
        "icon": {
          "light": "resources/light/star-fill.svg",
          "dark": "resources/dark/star-fill.svg"
        }
      },
      {
        "command": "squarecloud.openEntry",
        "title": "%command.open%"
      },
      {
        "command": "squarecloud.startEntry",
        "title": "%command.start%"
      },
      {
        "command": "squarecloud.stopEntry",
        "title": "%command.stop%"
      },
      {
        "command": "squarecloud.restartEntry",
        "title": "%command.restart%"
      },
      {
        "command": "squarecloud.deleteEntry",
        "title": "%command.delete%"
      },
      {
        "command": "squarecloud.commitEntry",
        "title": "%command.commit%"
      },
      {
        "command": "squarecloud.snapshotEntry",
        "title": "%command.snapshot%"
      },
      {
        "command": "squarecloud.snapshotRestoreEntry",
        "title": "%command.snapshotRestore%"
      },
      {
        "command": "squarecloud.copyIdEntry",
        "title": "%command.copyId%"
      },
      {
        "command": "squarecloud.envsEntry",
        "title": "%command.envs%"
      },
      {
        "command": "squarecloud.metricsEntry",
        "title": "%command.metrics%"
      },
      {
        "command": "squarecloud.realtimeEntry",
        "title": "%command.realtime%"
      },
      {
        "command": "squarecloud.linkGithubAppEntry",
        "title": "%command.linkGithub%"
      },
      {
        "command": "squarecloud.unlinkGithubAppEntry",
        "title": "%command.unlinkGithub%"
      },
      {
        "command": "squarecloud.networkErrorsEntry",
        "title": "%command.networkErrors%"
      },
      {
        "command": "squarecloud.networkLogsEntry",
        "title": "%command.networkLogs%"
      },
      {
        "command": "squarecloud.networkPerformanceEntry",
        "title": "%command.networkPerformance%"
      },
      {
        "command": "squarecloud.purgeCacheEntry",
        "title": "%command.purgeCache%"
      },
      {
        "command": "squarecloud.createWorkspace",
        "title": "%command.createWorkspace%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.deleteWorkspace",
        "title": "%command.deleteWorkspace%"
      },
      {
        "command": "squarecloud.leaveWorkspace",
        "title": "%command.leaveWorkspace%"
      },
      {
        "command": "squarecloud.generateInviteCode",
        "title": "%command.generateInviteCode%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.createDatabase",
        "title": "%command.createDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.startDatabase",
        "title": "%command.startDatabase%"
      },
      {
        "command": "squarecloud.stopDatabase",
        "title": "%command.stopDatabase%"
      },
      {
        "command": "squarecloud.deleteDatabase",
        "title": "%command.deleteDatabase%"
      },
      {
        "command": "squarecloud.downloadDatabaseCertificate",
        "title": "%command.downloadDatabaseCertificate%"
      },
      {
        "command": "squarecloud.showServiceStatus",
        "title": "%command.serviceStatus%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.logout",
        "title": "%command.logout%",
        "category": "Square Cloud"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "squarecloud-container",
          "title": "Square Cloud",
          "icon": "resources/squarecloud.svg"
        }
      ]
    },
    "views": {
      "squarecloud-container": [
        {
          "id": "auth-view",
          "name": "Square Cloud",
          "type": "webview",
          "icon": "resources/squarecloud.svg",
          "when": "!squarecloud.hideAuth"
        },
        {
          "id": "dashboard-view",
          "name": "Square Cloud",
          "type": "webview",
          "icon": "resources/squarecloud.svg",
          "when": "squarecloud.hideAuth"
        }
      ]
    },
    "configuration": [
      {
        "title": "Square Cloud",
        "properties": {
          "squarecloud.favApps": {
            "title": "Favorited apps will show in the explorer container.",
            "type": "array",
            "default": []
          }
        }
      }
    ],
    "languages": [
      {
        "id": "squarecloud.config",
        "icon": {
          "dark": "resources/dark/squarecloud.svg",
          "light": "resources/light/squarecloud.svg"
        },
        "aliases": [
          "Square Cloud Config"
        ],
        "filenames": [
          "squarecloud.config",
          "squarecloud.app"
        ]
      },
      {
        "id": "squareignore",
        "icon": {
          "dark": "resources/dark/squareignore.svg",
          "light": "resources/light/squareignore.svg"
        },
        "aliases": [
          "Square Cloud Ignore"
        ],
        "filenames": [
          "squarecloud.ignore"
        ]
      }
    ],
    "grammars": [
      {
        "language": "squarecloud.config",
        "scopeName": "source.squarecloud",
        "path": "./syntaxes/config.tmLanguage.json"
      }
    ]
  }
}
