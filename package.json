{
  "version": "5.3.0",
  "name": "squarecloud",
  "publisher": "squarecloud",
  "displayName": "Square Cloud",
  "description": "A VSCode extension for managing your Square Cloud applications.",
  "categories": [
    "Other"
  ],
  "icon": "resources/squarecloud.png",
  "galleryBanner": {
    "color": "#030405",
    "theme": "dark"
  },
  "packageManager": "pnpm@11.5.0",
  "keywords": [
    "squarecloud",
    "square cloud",
    "host",
    "bot",
    "website",
    "intellisense"
  ],
  "homepage": "https://github.com/squarecloudofc/vscode-extension/",
  "author": {
    "name": "João Gabriel Tonaco",
    "url": "https://github.com/joaotonaco/"
  },
  "contributors": [
    {
      "name": "João Otávio Stivi",
      "url": "https://github.com/JoaoOtavioS"
    }
  ],
  "sponsor": {
    "url": "https://squarecloud.app/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/squarecloudofc/vscode-extension"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "activationEvents": [
    "workspaceContains:**/squarecloud.app",
    "workspaceContains:**/squarecloud.config"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "lint": "biome check --write .",
    "build": "pnpm run check-types && pnpm run check-strings && pnpm run check-realtime && pnpm run check-problems && pnpm run check-key-sync && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "check-authorize": "node scripts/check-authorize.mjs",
    "watch": "concurrently --raw \"pnpm:watch:*\"",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "vscode:prepublish": "pnpm run build",
    "publish:vsce": "vsce publish --allow-star-activation --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "package": "vsce package --allow-star-activation --no-dependencies",
    "check-strings": "node scripts/check-strings.mjs",
    "check-realtime": "node scripts/check-realtime.mjs",
    "check-problems": "node scripts/check-problems.mjs",
    "check-key-sync": "node scripts/check-key-sync.mjs"
  },
  "dependencies": {
    "@squarecloud/api": "^6.0.0",
    "ignore": "^7.0.10",
    "jszip": "^3.10.1",
    "vscode-ext-localisation": "^1.1.0",
    "xoid": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "ovsx": "^1.1.1",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "menus": {
      "commandPalette": [
        {
          "command": "squarecloud.commitEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.copyIdEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.deleteDatabase",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.deleteEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.deleteWorkspace",
          "when": "false"
        },
        {
          "command": "squarecloud.downloadDatabaseCertificate",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.envsEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.favoriteEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.generateInviteCode",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.showServiceStatus",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.leaveWorkspace",
          "when": "false"
        },
        {
          "command": "squarecloud.linkGithubAppEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.logsEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.metricsEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.networkErrorsEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.networkLogsEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.networkPerformanceEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.openEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.purgeCacheEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.realtimeEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.refreshEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.refreshWorkspaces",
          "when": "false"
        },
        {
          "command": "squarecloud.restartEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.snapshotEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.snapshotRestoreEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.startDatabase",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.startEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.stopDatabase",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.stopEntry",
          "when": "squarecloud.hideAuth"
        },
        {
          "command": "squarecloud.unfavoriteEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.unlinkGithubAppEntry",
          "when": "squarecloud.hideAuth"
        }
      ],
      "view/title": [
        {
          "command": "squarecloud.refreshCache",
          "when": "view == dashboard-view",
          "group": "navigation@1"
        },
        {
          "command": "squarecloud.uploadApplication",
          "when": "view == dashboard-view",
          "group": "navigation@2"
        },
        {
          "command": "squarecloud.createDatabase",
          "when": "view == dashboard-view"
        },
        {
          "command": "squarecloud.createWorkspace",
          "when": "view == dashboard-view"
        },
        {
          "command": "squarecloud.generateInviteCode",
          "when": "view == dashboard-view"
        },
        {
          "command": "squarecloud.logout",
          "when": "view == dashboard-view"
        },
        {
          "command": "squarecloud.getStarted",
          "when": "view == auth-view"
        },
        {
          "command": "squarecloud.getStarted",
          "when": "view == dashboard-view"
        }
      ]
    },
    "commands": [
      {
        "command": "squarecloud.setApiKey",
        "title": "%palette.setApiKey%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.getStarted",
        "title": "%command.getStarted%",
        "category": "Square Cloud",
        "icon": "$(question)"
      },
      {
        "command": "squarecloud.uploadApplication",
        "title": "%palette.uploadApplication%",
        "category": "Square Cloud",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "squarecloud.refreshCache",
        "title": "%command.refresh%",
        "category": "Square Cloud",
        "icon": "$(refresh)"
      },
      {
        "command": "squarecloud.refreshEntry",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "squarecloud.refreshWorkspaces",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "squarecloud.logsEntry",
        "title": "%palette.logsEntry%",
        "category": "Square Cloud",
        "icon": "$(output)"
      },
      {
        "command": "squarecloud.favoriteEntry",
        "title": "%command.favorite%",
        "icon": "$(star-empty)"
      },
      {
        "command": "squarecloud.unfavoriteEntry",
        "title": "%command.unfavorite%",
        "icon": "$(star-full)"
      },
      {
        "command": "squarecloud.openEntry",
        "title": "%palette.openEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.startEntry",
        "title": "%palette.startEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.stopEntry",
        "title": "%palette.stopEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.restartEntry",
        "title": "%palette.restartEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.deleteEntry",
        "title": "%palette.deleteEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.commitEntry",
        "title": "%palette.commitEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.snapshotEntry",
        "title": "%palette.snapshotEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.snapshotRestoreEntry",
        "title": "%palette.snapshotRestoreEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.copyIdEntry",
        "title": "%palette.copyIdEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.envsEntry",
        "title": "%palette.envsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.metricsEntry",
        "title": "%palette.metricsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.realtimeEntry",
        "title": "%palette.realtimeEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.linkGithubAppEntry",
        "title": "%palette.linkGithubAppEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.unlinkGithubAppEntry",
        "title": "%palette.unlinkGithubAppEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.networkErrorsEntry",
        "title": "%palette.networkErrorsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.networkLogsEntry",
        "title": "%palette.networkLogsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.networkPerformanceEntry",
        "title": "%palette.networkPerformanceEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.purgeCacheEntry",
        "title": "%palette.purgeCacheEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.createWorkspace",
        "title": "%palette.createWorkspace%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.deleteWorkspace",
        "title": "%command.deleteWorkspace%"
      },
      {
        "command": "squarecloud.leaveWorkspace",
        "title": "%command.leaveWorkspace%"
      },
      {
        "command": "squarecloud.generateInviteCode",
        "title": "%palette.generateInviteCode%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.createDatabase",
        "title": "%palette.createDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.startDatabase",
        "title": "%palette.startDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.stopDatabase",
        "title": "%palette.stopDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.deleteDatabase",
        "title": "%palette.deleteDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.downloadDatabaseCertificate",
        "title": "%palette.downloadDatabaseCertificate%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.showServiceStatus",
        "title": "%palette.serviceStatus%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.logout",
        "title": "%palette.logout%",
        "category": "Square Cloud"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "squarecloud-container",
          "title": "Square Cloud",
          "icon": "resources/squarecloud.svg"
        }
      ]
    },
    "views": {
      "squarecloud-container": [
        {
          "id": "auth-view",
          "name": "Square Cloud",
          "type": "webview",
          "icon": "resources/squarecloud.svg",
          "when": "!squarecloud.hideAuth"
        },
        {
          "id": "dashboard-view",
          "name": "Square Cloud",
          "type": "webview",
          "icon": "resources/squarecloud.svg",
          "when": "squarecloud.hideAuth"
        }
      ]
    },
    "configuration": [
      {
        "title": "Square Cloud",
        "properties": {
          "squarecloud.favApps": {
            "title": "Favorited apps will show in the explorer container.",
            "type": "array",
            "default": []
          }
        }
      }
    ],
    "languages": [
      {
        "id": "squarecloud.config",
        "icon": {
          "dark": "resources/dark/squarecloud.svg",
          "light": "resources/light/squarecloud.svg"
        },
        "aliases": [
          "Square Cloud Config"
        ],
        "filenames": [
          "squarecloud.config",
          "squarecloud.app"
        ]
      },
      {
        "id": "squareignore",
        "icon": {
          "dark": "resources/dark/squareignore.svg",
          "light": "resources/light/squareignore.svg"
        },
        "aliases": [
          "Square Cloud Ignore"
        ],
        "filenames": [
          "squarecloud.ignore"
        ]
      }
    ],
    "grammars": [
      {
        "language": "squarecloud.config",
        "scopeName": "source.squarecloud",
        "path": "./syntaxes/config.tmLanguage.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "featuredFor": [
          "squarecloud.app",
          "squarecloud.config"
        ],
        "steps": [
          {
            "id": "connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "svg": "resources/walkthrough/connect.svg",
              "altText": "%walkthrough.connect.alt%"
            },
            "completionEvents": [
              "onContext:squarecloud.hideAuth"
            ]
          },
          {
            "id": "config",
            "title": "%walkthrough.config.title%",
            "description": "%walkthrough.config.description%",
            "media": {
              "svg": "resources/walkthrough/config.svg",
              "altText": "%walkthrough.config.alt%"
            }
          },
          {
            "id": "upload",
            "title": "%walkthrough.upload.title%",
            "description": "%walkthrough.upload.description%",
            "media": {
              "svg": "resources/walkthrough/upload.svg",
              "altText": "%walkthrough.upload.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.uploadApplication",
              "onCommand:squarecloud.commitEntry"
            ]
          },
          {
            "id": "manage",
            "title": "%walkthrough.manage.title%",
            "description": "%walkthrough.manage.description%",
            "media": {
              "svg": "resources/walkthrough/manage.svg",
              "altText": "%walkthrough.manage.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.startEntry",
              "onCommand:squarecloud.stopEntry",
              "onCommand:squarecloud.restartEntry",
              "onCommand:squarecloud.envsEntry"
            ]
          },
          {
            "id": "logs",
            "title": "%walkthrough.logs.title%",
            "description": "%walkthrough.logs.description%",
            "media": {
              "svg": "resources/walkthrough/logs.svg",
              "altText": "%walkthrough.logs.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.logsEntry",
              "onCommand:squarecloud.realtimeEntry",
              "onCommand:squarecloud.metricsEntry"
            ]
          },
          {
            "id": "snapshots",
            "title": "%walkthrough.snapshots.title%",
            "description": "%walkthrough.snapshots.description%",
            "media": {
              "svg": "resources/walkthrough/snapshots.svg",
              "altText": "%walkthrough.snapshots.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.snapshotEntry",
              "onCommand:squarecloud.snapshotRestoreEntry"
            ]
          },
          {
            "id": "databases",
            "title": "%walkthrough.databases.title%",
            "description": "%walkthrough.databases.description%",
            "media": {
              "svg": "resources/walkthrough/databases.svg",
              "altText": "%walkthrough.databases.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.createDatabase",
              "onCommand:squarecloud.downloadDatabaseCertificate"
            ]
          },
          {
            "id": "workspaces",
            "title": "%walkthrough.workspaces.title%",
            "description": "%walkthrough.workspaces.description%",
            "media": {
              "svg": "resources/walkthrough/workspaces.svg",
              "altText": "%walkthrough.workspaces.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.createWorkspace",
              "onCommand:squarecloud.generateInviteCode"
            ]
          },
          {
            "id": "github",
            "title": "%walkthrough.github.title%",
            "description": "%walkthrough.github.description%",
            "media": {
              "svg": "resources/walkthrough/github.svg",
              "altText": "%walkthrough.github.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.linkGithubAppEntry"
            ]
          },
          {
            "id": "network",
            "title": "%walkthrough.network.title%",
            "description": "%walkthrough.network.description%",
            "media": {
              "svg": "resources/walkthrough/network.svg",
              "altText": "%walkthrough.network.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.networkLogsEntry",
              "onCommand:squarecloud.networkErrorsEntry",
              "onCommand:squarecloud.networkPerformanceEntry",
              "onCommand:squarecloud.purgeCacheEntry"
            ]
          }
        ]
      }
    ]
  }
}
