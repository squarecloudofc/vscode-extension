{
  "version": "5.3.2",
  "name": "squarecloud",
  "publisher": "squarecloud",
  "displayName": "Square Cloud",
  "description": "Deploy, follow and configure your Square Cloud applications, databases and Blob storage without leaving VS Code.",
  "categories": [
    "Other"
  ],
  "icon": "resources/squarecloud.png",
  "galleryBanner": {
    "color": "#030405",
    "theme": "dark"
  },
  "packageManager": "pnpm@11.28.2",
  "keywords": [
    "squarecloud",
    "square cloud",
    "hosting",
    "deploy",
    "bot",
    "website",
    "database",
    "mcp",
    "intellisense"
  ],
  "homepage": "https://github.com/squarecloudofc/vscode-extension/",
  "author": {
    "name": "Square Cloud",
    "url": "https://squarecloud.app"
  },
  "contributors": [
    {
      "name": "João Otávio Stivi",
      "url": "https://github.com/joaootavios"
    },
    {
      "name": "João Gabriel Tonaco",
      "url": "https://github.com/joaotonaco"
    }
  ],
  "sponsor": {
    "url": "https://squarecloud.app/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/squarecloudofc/vscode-extension"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "activationEvents": [
    "workspaceContains:**/squarecloud.app",
    "workspaceContains:**/squarecloud.config",
    "onWebviewPanel:squarecloud.app",
    "onWebviewPanel:squarecloud.database",
    "onWebviewPanel:squarecloud.workspace",
    "onWebviewPanel:squarecloud.blob",
    "onFileSystem:squarecloud"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "lint": "biome check --write .",
    "build": "pnpm run check-types && pnpm run check-strings && pnpm run check-realtime && pnpm run check-problems && pnpm run check-key-sync && pnpm run check-env-quote && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "check-authorize": "node scripts/check-authorize.mjs",
    "watch": "concurrently --raw \"pnpm:watch:*\"",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:esbuild": "node esbuild.js --watch",
    "vscode:prepublish": "pnpm run build",
    "publish:vsce": "vsce publish --allow-star-activation --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "package": "vsce package --allow-star-activation --no-dependencies",
    "check-strings": "node scripts/check-strings.mjs",
    "check-realtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-realtime.mjs",
    "check-problems": "node scripts/check-problems.mjs",
    "check-key-sync": "node scripts/check-key-sync.mjs",
    "check-env-quote": "node scripts/check-env-quote.mjs",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"test/*.test.ts\""
  },
  "dependencies": {
    "@squarecloud/api": "^6.1.0",
    "@squarecloud/blob": "^4.2.0",
    "ignore": "^7.0.10",
    "jszip": "^3.10.2",
    "preact": "^10.29.8",
    "vscode-ext-localisation": "^1.1.0",
    "xoid": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "menus": {
      "commandPalette": [
        {
          "command": "squarecloud.commitEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.copyIdEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.databaseMetrics",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.deleteDatabase",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.deleteEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.deleteWorkspace",
          "when": "false"
        },
        {
          "command": "squarecloud.downloadDatabaseCertificate",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.envsEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.favoriteEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.generateInviteCode",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.leaveWorkspace",
          "when": "false"
        },
        {
          "command": "squarecloud.linkGithubAppEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.logout",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.logsEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.metricsEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.networkErrorsEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.networkLogsEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.networkPerformanceEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.openBlob",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.openEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.openWorkspace",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.purgeCacheEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.realtimeEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.refreshCache",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.restartEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.showServiceStatus",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.snapshotEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.snapshotRestoreEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.startDatabase",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.startEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.stopDatabase",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.stopEntry",
          "when": "squarecloud.connected"
        },
        {
          "command": "squarecloud.unfavoriteEntry",
          "when": "false"
        },
        {
          "command": "squarecloud.unlinkGithubAppEntry",
          "when": "squarecloud.connected"
        }
      ],
      "view/title": [
        {
          "command": "squarecloud.refreshCache",
          "when": "view == squarecloud.sidebar && squarecloud.connected",
          "group": "navigation@1"
        },
        {
          "command": "squarecloud.uploadApplication",
          "when": "view == squarecloud.sidebar && squarecloud.connected",
          "group": "navigation@2"
        },
        {
          "command": "squarecloud.createDatabase",
          "when": "view == squarecloud.sidebar && squarecloud.connected",
          "group": "1_create@1"
        },
        {
          "command": "squarecloud.createWorkspace",
          "when": "view == squarecloud.sidebar && squarecloud.connected",
          "group": "1_create@2"
        },
        {
          "command": "squarecloud.generateInviteCode",
          "when": "view == squarecloud.sidebar && squarecloud.connected",
          "group": "1_create@3"
        },
        {
          "command": "squarecloud.showServiceStatus",
          "when": "view == squarecloud.sidebar && squarecloud.connected",
          "group": "2_help@1"
        },
        {
          "command": "squarecloud.getStarted",
          "when": "view == squarecloud.sidebar",
          "group": "2_help@2"
        },
        {
          "command": "squarecloud.logout",
          "when": "view == squarecloud.sidebar && squarecloud.connected",
          "group": "3_account@1"
        }
      ]
    },
    "commands": [
      {
        "command": "squarecloud.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.getStarted",
        "title": "%command.getStarted%",
        "category": "Square Cloud",
        "icon": "$(question)"
      },
      {
        "command": "squarecloud.uploadApplication",
        "title": "%command.uploadApplication%",
        "category": "Square Cloud",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "squarecloud.refreshCache",
        "title": "%command.refreshCache%",
        "category": "Square Cloud",
        "icon": "$(refresh)"
      },
      {
        "command": "squarecloud.logsEntry",
        "title": "%command.logsEntry%",
        "category": "Square Cloud",
        "icon": "$(output)"
      },
      {
        "command": "squarecloud.favoriteEntry",
        "title": "%command.favoriteEntry%",
        "icon": "$(star-empty)"
      },
      {
        "command": "squarecloud.unfavoriteEntry",
        "title": "%command.unfavoriteEntry%",
        "icon": "$(star-full)"
      },
      {
        "command": "squarecloud.openEntry",
        "title": "%command.openEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.startEntry",
        "title": "%command.startEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.stopEntry",
        "title": "%command.stopEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.restartEntry",
        "title": "%command.restartEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.deleteEntry",
        "title": "%command.deleteEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.commitEntry",
        "title": "%command.commitEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.snapshotEntry",
        "title": "%command.snapshotEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.snapshotRestoreEntry",
        "title": "%command.snapshotRestoreEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.copyIdEntry",
        "title": "%command.copyIdEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.envsEntry",
        "title": "%command.envsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.metricsEntry",
        "title": "%command.metricsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.realtimeEntry",
        "title": "%command.realtimeEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.linkGithubAppEntry",
        "title": "%command.linkGithubAppEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.unlinkGithubAppEntry",
        "title": "%command.unlinkGithubAppEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.networkErrorsEntry",
        "title": "%command.networkErrorsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.networkLogsEntry",
        "title": "%command.networkLogsEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.networkPerformanceEntry",
        "title": "%command.networkPerformanceEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.purgeCacheEntry",
        "title": "%command.purgeCacheEntry%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.createWorkspace",
        "title": "%command.createWorkspace%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.deleteWorkspace",
        "title": "%command.deleteWorkspace%"
      },
      {
        "command": "squarecloud.leaveWorkspace",
        "title": "%command.leaveWorkspace%"
      },
      {
        "command": "squarecloud.generateInviteCode",
        "title": "%command.generateInviteCode%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.openWorkspace",
        "title": "%command.openWorkspace%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.createDatabase",
        "title": "%command.createDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.startDatabase",
        "title": "%command.startDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.stopDatabase",
        "title": "%command.stopDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.deleteDatabase",
        "title": "%command.deleteDatabase%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.databaseMetrics",
        "title": "%command.databaseMetrics%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.downloadDatabaseCertificate",
        "title": "%command.downloadDatabaseCertificate%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.openBlob",
        "title": "%command.openBlob%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.showServiceStatus",
        "title": "%command.showServiceStatus%",
        "category": "Square Cloud"
      },
      {
        "command": "squarecloud.logout",
        "title": "%command.logout%",
        "category": "Square Cloud"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "squarecloud-container",
          "title": "Square Cloud",
          "icon": "resources/squarecloud.svg"
        }
      ]
    },
    "views": {
      "squarecloud-container": [
        {
          "id": "squarecloud.sidebar",
          "name": "Square Cloud",
          "type": "webview",
          "icon": "resources/squarecloud.svg"
        }
      ]
    },
    "configuration": [
      {
        "title": "Square Cloud",
        "properties": {
          "squarecloud.favApps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.favApps%"
          }
        }
      }
    ],
    "languages": [
      {
        "id": "squarecloud.config",
        "icon": {
          "dark": "resources/dark/squarecloud.svg",
          "light": "resources/light/squarecloud.svg"
        },
        "aliases": [
          "Square Cloud Config"
        ],
        "filenames": [
          "squarecloud.config",
          "squarecloud.app"
        ]
      },
      {
        "id": "squareignore",
        "icon": {
          "dark": "resources/dark/squareignore.svg",
          "light": "resources/light/squareignore.svg"
        },
        "aliases": [
          "Square Cloud Ignore"
        ],
        "filenames": [
          "squarecloud.ignore"
        ]
      }
    ],
    "grammars": [
      {
        "language": "squarecloud.config",
        "scopeName": "source.squarecloud",
        "path": "./syntaxes/config.tmLanguage.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "featuredFor": [
          "squarecloud.app",
          "squarecloud.config"
        ],
        "steps": [
          {
            "id": "connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "svg": "resources/walkthrough/connect.svg",
              "altText": "%walkthrough.connect.alt%"
            },
            "completionEvents": [
              "onContext:squarecloud.connected"
            ]
          },
          {
            "id": "sidebar",
            "title": "%walkthrough.sidebar.title%",
            "description": "%walkthrough.sidebar.description%",
            "media": {
              "svg": "resources/walkthrough/sidebar.svg",
              "altText": "%walkthrough.sidebar.alt%"
            },
            "completionEvents": [
              "onView:squarecloud.sidebar"
            ]
          },
          {
            "id": "config",
            "title": "%walkthrough.config.title%",
            "description": "%walkthrough.config.description%",
            "media": {
              "svg": "resources/walkthrough/config.svg",
              "altText": "%walkthrough.config.alt%"
            }
          },
          {
            "id": "upload",
            "title": "%walkthrough.upload.title%",
            "description": "%walkthrough.upload.description%",
            "media": {
              "svg": "resources/walkthrough/upload.svg",
              "altText": "%walkthrough.upload.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.uploadApplication",
              "onCommand:squarecloud.commitEntry"
            ]
          },
          {
            "id": "panel",
            "title": "%walkthrough.panel.title%",
            "description": "%walkthrough.panel.description%",
            "media": {
              "svg": "resources/walkthrough/panel.svg",
              "altText": "%walkthrough.panel.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.metricsEntry",
              "onCommand:squarecloud.startEntry",
              "onCommand:squarecloud.stopEntry",
              "onCommand:squarecloud.restartEntry"
            ]
          },
          {
            "id": "logs",
            "title": "%walkthrough.logs.title%",
            "description": "%walkthrough.logs.description%",
            "media": {
              "svg": "resources/walkthrough/logs.svg",
              "altText": "%walkthrough.logs.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.logsEntry",
              "onCommand:squarecloud.realtimeEntry"
            ]
          },
          {
            "id": "files",
            "title": "%walkthrough.files.title%",
            "description": "%walkthrough.files.description%",
            "media": {
              "svg": "resources/walkthrough/files.svg",
              "altText": "%walkthrough.files.alt%"
            }
          },
          {
            "id": "snapshots",
            "title": "%walkthrough.snapshots.title%",
            "description": "%walkthrough.snapshots.description%",
            "media": {
              "svg": "resources/walkthrough/snapshots.svg",
              "altText": "%walkthrough.snapshots.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.snapshotEntry",
              "onCommand:squarecloud.snapshotRestoreEntry"
            ]
          },
          {
            "id": "databases",
            "title": "%walkthrough.databases.title%",
            "description": "%walkthrough.databases.description%",
            "media": {
              "svg": "resources/walkthrough/databases.svg",
              "altText": "%walkthrough.databases.alt%"
            },
            "completionEvents": [
              "onCommand:squarecloud.createDatabase",
              "onCommand:squarecloud.databaseMetrics",
              "onCommand:squarecloud.downloadDatabaseCertificate",
              "onCommand:squarecloud.openBlob"
            ]
          },
          {
            "id": "agent",
            "title": "%walkthrough.agent.title%",
            "description": "%walkthrough.agent.description%",
            "media": {
              "svg": "resources/walkthrough/agent.svg",
              "altText": "%walkthrough.agent.alt%"
            }
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "squarecloud.mcp",
        "label": "Square Cloud"
      }
    ]
  }
}
